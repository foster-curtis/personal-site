# Copy this file to .env.local and fill in real values.
# See docs/dev-setup.md#environment-variables for what each var gates and
# which routes break without it.

# --- Supabase (required) ---------------------------------------------------
# Project URL and anon key, from Supabase project settings > API.
# Used with a non-null assertion in lib/supabase/* and middleware.ts, so a
# missing value throws at request time on nearly every route.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — bypasses Row Level Security entirely via
# lib/supabase/admin.ts. Required for chat, about, job-compare, public
# feedback routes, and embedding sync. Treat as a secret with full DB access.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (required for any AI feature) ----------------------------------
GEMINI_API_KEY=
# Optional, defaults to gemini-2.5-flash. Generation model only — embeddings
# are hardcoded to text-embedding-004 regardless of this value.
GEMINI_MODEL=

# --- Owner identity (required) ---------------------------------------------
# The only email isOwner() will treat as the site owner. See
# docs/auth-and-security.md.
OWNER_EMAIL=
# Display name used server-side (About page, feedback analysis prompts).
OWNER_NAME=
# Same display name, but client-readable (references page, feedback form).
# Keep in sync with OWNER_NAME above.
NEXT_PUBLIC_OWNER_NAME=

# --- Analytics (optional) ---------------------------------------------------
# Analytics is fully disabled (no client init at all) if left unset.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
